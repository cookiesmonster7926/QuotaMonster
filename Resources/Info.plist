<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ⚠️ 通知授權綁在 CFBundleIdentifier 上。一旦使用者做過授權決定，
         改這個字串等於變成另一個 app，授權會歸零。不要改。 -->
    <key>CFBundleIdentifier</key>            <string>com.cookiesmonster.QuotaMonster</string>
    <key>CFBundleName</key>                  <string>QuotaMonster</string>
    <key>CFBundleDisplayName</key>           <string>QuotaMonster</string>
    <key>CFBundleExecutable</key>            <string>QuotaMonsterApp</string>
    <key>CFBundlePackageType</key>           <string>APPL</string>
    <key>CFBundleShortVersionString</key>    <string>0.1.0</string>
    <key>CFBundleVersion</key>               <string>1</string>
    <key>CFBundleInfoDictionaryVersion</key> <string>6.0</string>
    <key>LSMinimumSystemVersion</key>        <string>14.0</string>
    <!-- menu bar only：不出現在 Dock，也不出現在 Cmd-Tab -->
    <key>LSUIElement</key>                   <true/>
    <!-- app icon。⚠️ CFBundleIconFile 指的是 Contents/Resources/ 底下的檔名
         （副檔名可省）。**不要**加 CFBundleIconName —— 那個鍵指的是 asset
         catalog 裡的 entry，而這個 bundle 沒有 Assets.car，設了會指向不存在的東西。
         .icns 由 make_app.sh 呼叫 `--render-icon` + iconutil 產生，不入版控：
         來源是 Sources/QuotaMonsterApp/Glyph/IconRenderer.swift。 -->
    <key>CFBundleIconFile</key>              <string>AppIcon</string>
    <key>NSHumanReadableCopyright</key>      <string>Copyright 2026 CookiesMonster. Apache License 2.0.</string>
</dict>
</plist>
